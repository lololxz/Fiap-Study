# Copie para `.env.local` e preencha os valores.
#
#   cp .env.example .env.local
#
# O `.env` (não-secreto, versionado) já traz o DATABASE_URL porque o Prisma CLI
# lê `.env` e não `.env.local`.

# ---------------------------------------------------------------- banco
# SQLite local. O caminho é relativo à pasta `prisma/`.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------- sessão
# Assina o cookie de sessão (NextAuth com strategy jwt). Quem conhece este valor
# forja um token de qualquer usuário, então NUNCA use um literal.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em produção a aplicação recusa subir com valor ausente, curto (<32) ou conhecido.
NEXTAUTH_SECRET=""

# URL pública da aplicação. Em produção, o domínio real.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- IA
# O app usa um provedor compatível com a API da OpenAI.
# Sem XKIRO_API_KEY, as rotas de IA respondem 503 com mensagem explicativa
# (a geração de temas de redação cai para uma lista fixa).
XKIRO_API_KEY=""
XKIRO_BASE_URL="https://api.xkiro.com/v1"
XKIRO_MODEL="qwen/qwen3.6-27b:free"

# Alternativa: se XKIRO_API_KEY estiver vazia, o app usa OPENAI_API_KEY.
OPENAI_API_KEY=""
